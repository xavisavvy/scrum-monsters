name: Deploy

on:
  push:
    branches: [main]
    paths:
      - "k8s/**"
      - "!k8s/infrastructure/**"
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy to"
        required: true
        default: "dev"
        type: choice
        options:
          - dev
          - staging
          - prod

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read

env:
  ARGOCD_SERVER: argocd.local

jobs:
  # Validate Kustomize manifests
  validate:
    name: Validate Manifests
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Kustomize
        uses: imranismail/setup-kustomize@v2

      - name: Validate dev overlay
        run: kustomize build k8s/overlays/dev > /dev/null

      - name: Validate staging overlay
        run: kustomize build k8s/overlays/staging > /dev/null

      - name: Validate prod overlay
        run: kustomize build k8s/overlays/prod > /dev/null

  # Trigger ArgoCD sync for dev (auto on push to main)
  deploy-dev:
    name: Deploy to Dev
    runs-on: ubuntu-latest
    needs: validate
    if: github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && github.event.inputs.environment == 'dev')
    environment:
      name: development
      url: https://scrumquest-dev.local

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Note: ArgoCD auto-sync handles deployment automatically
      # This step just logs the deployment for tracking
      - name: Log deployment
        run: |
          echo "Deployment triggered for dev environment"
          echo "Commit: ${{ github.sha }}"
          echo "ArgoCD will auto-sync from main branch"

  # Staging deployment (manual trigger or workflow_dispatch)
  deploy-staging:
    name: Deploy to Staging
    runs-on: ubuntu-latest
    needs: validate
    if: github.event_name == 'workflow_dispatch' && github.event.inputs.environment == 'staging'
    environment:
      name: staging
      url: https://staging.scrumquest.local

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install ArgoCD CLI
        run: |
          curl -sSL -o argocd https://github.com/argoproj/argo-cd/releases/download/v2.13.3/argocd-linux-amd64
          chmod +x argocd
          sudo mv argocd /usr/local/bin/

      - name: Sync staging application
        env:
          ARGOCD_AUTH_TOKEN: ${{ secrets.ARGOCD_AUTH_TOKEN }}
        run: |
          argocd app sync scrumquest-staging \
            --server $ARGOCD_SERVER \
            --grpc-web \
            --prune \
            --timeout 300

  # Production deployment (requires approval)
  deploy-prod:
    name: Deploy to Production
    runs-on: ubuntu-latest
    needs: validate
    if: github.event_name == 'workflow_dispatch' && github.event.inputs.environment == 'prod'
    environment:
      name: production
      url: https://scrumquest.com

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install ArgoCD CLI
        run: |
          curl -sSL -o argocd https://github.com/argoproj/argo-cd/releases/download/v2.13.3/argocd-linux-amd64
          chmod +x argocd
          sudo mv argocd /usr/local/bin/

      - name: Sync production application
        env:
          ARGOCD_AUTH_TOKEN: ${{ secrets.ARGOCD_AUTH_TOKEN }}
        run: |
          argocd app sync scrumquest-prod \
            --server $ARGOCD_SERVER \
            --grpc-web \
            --prune \
            --timeout 600

      - name: Wait for healthy status
        env:
          ARGOCD_AUTH_TOKEN: ${{ secrets.ARGOCD_AUTH_TOKEN }}
        run: |
          argocd app wait scrumquest-prod \
            --server $ARGOCD_SERVER \
            --grpc-web \
            --health \
            --timeout 300
