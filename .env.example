# Database Configuration (Optional - defaults to in-memory storage)
# DATABASE_URL="postgresql://username:password@localhost:5432/scrum_poker"

# Connection Pool Configuration (only used when DATABASE_URL is set)
# DB_POOL_MAX=10              # Maximum connections in pool (1-100)
# DB_POOL_IDLE_TIMEOUT=60     # Close idle connections after N seconds
# DB_POOL_CONNECT_TIMEOUT=10  # Connection timeout in seconds

# Session Configuration
SESSION_SECRET="your-super-secret-session-key-change-this-in-production"

# Auth0 Configuration (Optional - enables authentication)
# Create a Regular Web Application at https://manage.auth0.com
# AUTH0_ISSUER_BASE_URL="https://your-tenant.us.auth0.com"
# AUTH0_CLIENT_ID="your-auth0-client-id"
# AUTH0_CLIENT_SECRET="your-auth0-client-secret"
# AUTH0_SECRET="a-random-string-at-least-32-characters-long"
# BASE_URL="http://localhost:5000"

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (recommended for production)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="https://scrummonsters.com,https://www.scrummonsters.com"
