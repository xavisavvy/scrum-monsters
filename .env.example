# Database Configuration (Optional - defaults to in-memory storage)
# DATABASE_URL="postgresql://username:password@localhost:5432/scrum_poker"

# Connection Pool Configuration (only used when DATABASE_URL is set)
# DB_POOL_MAX=10              # Maximum connections in pool (1-100)
# DB_POOL_IDLE_TIMEOUT=60     # Close idle connections after N seconds
# DB_POOL_CONNECT_TIMEOUT=10  # Connection timeout in seconds

# Session Configuration
SESSION_SECRET="your-super-secret-session-key-change-this-in-production"

# OAuth Configuration (Optional - enables social login)
# Google OAuth - https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth - https://github.com/settings/developers
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (recommended for production)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="https://scrummonsters.com,https://www.scrummonsters.com"