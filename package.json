{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "up": "docker compose up -d postgres && npm run db:push && npm run dev",
    "down": "docker compose down",
    "services:up": "docker compose up -d postgres",
    "services:down": "docker compose down",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test e2e/visual/",
    "test:visual:update": "playwright test e2e/visual/ --update-snapshots",
    "test:a11y": "playwright test e2e/a11y/",
    "test:load": "echo 'Requires k6 binary. Run: k6 run tests/load/http/smoke.test.js'",
    "test:load:http": "k6 run tests/load/http/smoke.test.js --out json=results-http-smoke.json",
    "test:load:http:full": "k6 run tests/load/http/average-load.test.js --out json=results-http-load.json",
    "test:load:ws": "k6 run tests/load/websocket/game-flow.test.js --out json=results-ws-game.json",
    "test:load:idle": "k6 run tests/load/websocket/idle-connection.test.js --out json=results-idle.json",
    "profile": "tsx tests/profiling/run-profile.ts",
    "profile:report": "tsx tests/profiling/generate-report.ts",
    "generate:api-types": "openapi-typescript specs/openapi.yaml -o shared/api-types.generated.ts",
    "lint:api-spec": "spectral lint specs/openapi.yaml --ruleset specs/.spectral.yaml",
    "lint:asyncapi-spec": "spectral lint specs/asyncapi.yaml --ruleset specs/.spectral.yaml",
    "lint:specs": "npm run lint:api-spec && npm run lint:asyncapi-spec",
    "validate:specs": "npm run lint:specs && npm run generate:api-types",
    "validate:api-spec": "npm run lint:api-spec && npm run generate:api-types",
    "dev": "cross-env NODE_ENV=development tsx --env-file=.env server/index.ts",
    "dev:ci": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:watch": "cross-env NODE_ENV=development tsx --watch --env-file=.env server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:push": "drizzle-kit push",
    "db:migrate:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "husky",
    "audit": "audit-ci --config .audit-ci.json",
    "scan": "trivy fs --scanners vuln,secret,misconfig --skip-dirs node_modules,dist,.planning,client/public,playwright-report,test-results,coverage --severity HIGH,CRITICAL --exit-code 0 .",
    "scan:secrets": "trivy fs --scanners secret --exit-code 1 .",
    "scan:image": "docker build -t scrum-monsters:scan . && trivy image --severity HIGH,CRITICAL scrum-monsters:scan",
    "scan:sarif": "trivy fs --format sarif --output trivy.sarif --scanners vuln,secret,misconfig --skip-dirs node_modules,dist,.planning,client/public,playwright-report,test-results,coverage .",
    "license-check": "license-checker-rseidelsohn --onlyAllow 'MIT;MIT*;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BSD*;ISC;0BSD;Unlicense;CC0-1.0;OFL-1.1;Zlib;BlueOak-1.0.0;Hippocratic-2.1;MIT AND ISC' --excludePackages 'gsap' --production",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:dry-run": "standard-version --dry-run",
    "version:check": "echo \"Current version: $(node -p \"require('./package.json').version\")\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
